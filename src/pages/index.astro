---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import AppsWidget from "@/components/AppsWidget.astro";
import ReleasesWidget from "@/components/ReleasesWidget.astro";
import MediumStories from "@/components/MediumStories.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { fetchMediumPosts } from "@/utils/medium";
import { medium, profile } from "@/data/site-data";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts).slice(0, 2);
const mediumStories = await fetchMediumPosts(medium.feedUrl, 3);
const homePath = getRelativeLocaleUrl(locale, "");
const [headingLead, ...headingRest] = profile.heading.split(",");
const headingTail = headingRest.join(",").trim();
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <div
      class="grid gap-12 py-8 lg:grid-cols-[minmax(0,3fr)_minmax(22rem,2fr)] lg:gap-0"
    >
      <section
        id="articles"
        class="border-border border-b lg:border-e lg:border-b-0 lg:pe-8 xl:pe-12"
        aria-labelledby="articles-heading"
      >
        <h2 id="articles-heading" class="text-2xl font-semibold tracking-wide">
          Articles
        </h2>

        <section id="latest-posts" aria-labelledby="latest-posts-heading">
          <div
            class="border-border mt-6 flex items-baseline justify-between gap-4 border-b pb-3"
          >
            <h3
              id="latest-posts-heading"
              class="text-xl font-semibold tracking-wide"
            >
              Latest posts
            </h3>
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              All posts
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          {
            recentPosts.length > 0 ? (
              <ul>
                {recentPosts.map(post => (
                  <Card variant="h4" {...post} />
                ))}
              </ul>
            ) : (
              <p class="text-muted-foreground py-8">No posts published yet.</p>
            )
          }
        </section>

        <MediumStories profileUrl={medium.profileUrl} stories={mediumStories} />
      </section>

      <aside
        class="space-y-8 lg:ps-8 xl:ps-12"
        aria-label="Profile, projects, and release updates"
      >
        <section id="bio" class="border-border border-b pb-8">
          <div class="flex items-start gap-4">
            <img
              src={profile.image}
              alt={profile.imageAlt}
              width="450"
              height="450"
              class="border-accent size-28 shrink-0 rounded-full border object-cover"
            />
            <h1 class="text-xl leading-snug font-semibold tracking-tight">
              {headingLead}{headingTail && ","}
              {headingTail && <br />}
              {headingTail}
            </h1>
          </div>
          <p class="text-muted-foreground mt-4 text-base leading-relaxed">
            {profile.bio}
          </p>
          <div class="mt-4 flex items-center gap-2">
            <span class="text-base">Find me online:</span>
            <Socials />
          </div>
        </section>
        <AppsWidget />
        <ReleasesWidget />
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout =
      document.querySelector<HTMLElement>("#main-content")?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
