---
import { releaseRepositories } from "@/data/site-data";
---

<section
  id="releases-widget"
  aria-labelledby="releases-heading"
  data-repository-count={releaseRepositories.length}
>
  <h2 id="releases-heading" class="text-2xl font-semibold">Latest releases</h2>
  <p
    data-release-status
    class="text-muted-foreground mt-3 font-mono text-sm"
    role="status"
    aria-live="polite"
  >
    Loading releases…
  </p>
  <ul data-release-list class="mt-3 hidden space-y-1"></ul>
</section>

<script>
  import { releaseRepositories } from "@/data/site-data";
  import {
    fetchGitHubReleases,
    getReleaseCache,
    setReleaseCache,
    type DisplayRelease,
  } from "@/utils/releases";

  function renderReleases(
    root: HTMLElement,
    releases: DisplayRelease[],
    message: string
  ) {
    const status = root.querySelector<HTMLElement>("[data-release-status]");
    const list = root.querySelector<HTMLUListElement>("[data-release-list]");
    if (!status || !list) return;

    list.replaceChildren();
    for (const release of releases) {
      const item = document.createElement("li");
      item.className = "border-border border-t py-4 first:border-t-0";

      const link = document.createElement("a");
      link.className =
        "text-accent focus-outline text-lg font-medium break-words hover:underline";
      link.href = release.url;
      link.textContent = release.name;

      const meta = document.createElement("p");
      meta.className = "text-muted-foreground mt-1 font-mono text-sm";
      const date = new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
      }).format(new Date(release.publishedAt));
      meta.textContent = `${release.repository} · ${date}`;

      item.append(link, meta);
      list.append(item);
    }

    list.classList.toggle("hidden", releases.length === 0);
    status.textContent = message;
    status.classList.toggle("sr-only", releases.length > 0 && !message);
  }

  async function loadReleases() {
    const root = document.querySelector<HTMLElement>("#releases-widget");
    if (!root || root.dataset.loading === "true") return;
    root.dataset.loading = "true";

    const cached = getReleaseCache(localStorage);
    if (cached) {
      renderReleases(root, cached, "");
      root.dataset.loading = "false";
      return;
    }

    const result = await fetchGitHubReleases(releaseRepositories);
    if (result.releases.length > 0) {
      setReleaseCache(localStorage, result.releases);
      const message = result.failedCount
        ? "Some repositories could not be updated."
        : "";
      renderReleases(root, result.releases, message);
    } else if (result.rateLimited) {
      renderReleases(
        root,
        [],
        "GitHub's request limit was reached. Try again later."
      );
    } else if (releaseRepositories.length === 0) {
      renderReleases(root, [], "No release repositories are configured.");
    } else {
      renderReleases(root, [], "Releases are temporarily unavailable.");
    }

    root.dataset.loading = "false";
  }

  document.addEventListener("astro:page-load", loadReleases);
</script>
