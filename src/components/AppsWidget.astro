---
import AppStatus from "./AppStatus.astro";
import { apps } from "@/data/site-data";
---

<section aria-labelledby="apps-heading" class="border-border border-b pb-8">
  <h2 id="apps-heading" class="text-2xl font-semibold">Apps &amp; services</h2>
  <ul class="mt-3 space-y-1">
    {
      apps.map(app => (
        <li class="border-border border-t py-4 first:border-t-0">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <a
                href={app.url}
                class="text-accent focus-outline text-lg font-medium break-words hover:underline"
              >
                {app.name}
              </a>
              {app.description && (
                <p class="text-muted-foreground mt-1 font-mono text-sm">
                  {app.description}
                </p>
              )}
            </div>
            <AppStatus status={app.status} />
          </div>
        </li>
      ))
    }
  </ul>
</section>
